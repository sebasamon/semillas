{
  // Debe coincidir con el nombre del Worker en Cloudflare.
  "name": "semillas",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "encuesta-semillas",
      "database_id": "eacff7ee-df37-42a7-bbb1-828d864542c8"
    }
  ],
  "observability": { "enabled": true }
}
